# RabbitMQ host
RABBITMQ_HOST=rabbitmq

# Database variables
DATABASE_NAME=gis
DATABASE_USERNAME=docker
DATABASE_PASSWORD=docker
DATABASE_HOST=db

# Django settings
DJANGO_SETTINGS_MODULE=settings_docker
# Local settings path
DJANGO_LOCAL_SETTINGS='settings_local.py'
DEBUG=False

# Django signing key. The value below is a placeholder for local development
# and CI only -- it is in a public repository, so it is not a secret.
# GENERATE YOUR OWN before deploying anywhere real:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Django will not start if this is unset.
SECRET_KEY='dev-only-placeholder-CHANGE-ME-before-deploying'

# Docker volumes
QGISPLUGINS_STATIC_VOLUME=static-data
QGISPLUGINS_MEDIA_VOLUME=media-data
QGISPLUGINS_BACKUP_VOLUME=backups-data

# Email
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST='smtp.resend.com'
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER="resend"
EMAIL_HOST_PASSWORD=""  # Your Resend API key
EMAIL_SUBJECT_PREFIX='[QGIS Plugins] '
DEFAULT_FROM_EMAIL='no-reply-plugins@qgis.org'

# URL
DOMAIN_NAME='plugins.qgis.org'
DEFAULT_PLUGINS_SITE='https://plugins.qgis.org/'

# ENV: debug, staging-ssl, prod, prod-ssl
QGISPLUGINS_ENV=debug

# Ldap
ENABLE_LDAP=False

# SENTRY
SENTRY_DSN=''

# Set traces_sample_rate to 1.0 to capture 100%
# of transactions for performance monitoring.
SENTRY_RATE=1.0

# Download stats URL
METABASE_DOWNLOAD_STATS_URL='https://plugins.qgis.org/metabase/public/dashboard/<dashboard_id>'

# Upcoming QGIS Major Version
NEW_QGIS_MAJOR_VERSION='4'

CURRENT_QGIS_MAJOR_VERSION='3'

# Uwsgi Docker image
UWSGI_DOCKER_IMAGE='qgis/qgis-plugins-uwsgi:latest'

# Metabase Docker Image.
#
# Pin this. Metabase migrates its own application database on first start of a
# new version, and those migrations are one-way -- there is no supported
# downgrade. Left on :latest, an unrelated re-pull can upgrade Metabase and
# rewrite its schema with no change on our side and no way back.
#
# On an EXISTING deployment, set this to the version already running before
# deploying (docker compose exec metabase java -jar /app/metabase.jar version,
# or read it from the Metabase admin UI). Do not let this commit be the thing
# that upgrades it.
METABASE_DOCKER_IMAGE='metabase/metabase:v0.63.13'

# Rabbitmq docker image. Uncomment only to override the compose default
# (rabbitmq:3.13-alpine).
#
# Do not set this to 4.x: RabbitMQ 4 removed transient non-exclusive queues and
# Celery still declares them, so the worker crash-loops. Note also that 4.x
# cannot read a data directory written by 3.7.
# See docs/RABBITMQ-UPGRADE.md before changing this on a running host.
# RABBITMQ_IMAGE='rabbitmq:3.13-alpine'

# Celery for check Qt6
CELERY_RESULT_BACKEND=rpc://
CELERY_BROKER_URL=amqp://rabbitmq:5672
